# Used only by the optional local/API generator or GitHub Actions.
# Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Advance editions are bounded, evergreen research and default to the cheaper mini model.
OPENAI_ADVANCE_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=medium
OPENAI_ADVANCE_REASONING_EFFORT=low
