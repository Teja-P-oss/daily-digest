# Used only by the optional local/API generator or GitHub Actions.
# Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Advance editions use the full-quality model by default. Set this to gpt-5.4-mini only when
# deliberately opting into the cheaper profile with --cheap-advance.
OPENAI_ADVANCE_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_ADVANCE_REASONING_EFFORT=medium
